# Argus Agent: runs on every node (DaemonSet), built for any CPU architecture.
# Build from the repository root:
#   docker buildx build -f deploy/docker/Dockerfile.agent --platform linux/amd64,linux/arm64 -t <name> .

FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags "-s -w" -o /out/argus-agent ./internal/cmd/agent
RUN apk add --no-cache ca-certificates tzdata

FROM alpine:3.22
COPY --from=build /etc/ssl/certs /etc/ssl/certs
COPY --from=build /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=build /out/argus-agent /argus-agent
ENTRYPOINT ["/argus-agent"]
